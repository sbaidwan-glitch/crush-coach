# Which environment variables exist. Copied to .env on first build.
# Never put real secrets in this file — it is committed.

# Local Postgres from docker-compose.yml (class 12).
# On Railway, this is replaced by the URL Railway gives you.
DATABASE_URL=postgresql://e190bo:localdev@localhost:5432/app

# Google Drive. Put credentials in one of the first two variables, never here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Coach (src/llm.py). The key stays in the environment, never in this file.
GLASSROOM_API_KEY=
# Model name; blank uses the default (claude-sonnet-5).
COACH_MODEL=
# Messages per member per day; blank uses the default (20).
COACH_DAILY_LIMIT=
# "Tidy my note" in the work log: its model (blank: claude-haiku-4-5) and how many tidies
# a member gets per day (blank: 20).
TIDY_MODEL=
TIDY_DAILY_LIMIT=

# The Notebook: "Suggest specs" per member per day (blank: 10).
SPECS_DAILY_LIMIT=
# A Drive folder shared with the service account as Editor. Published notebook entries put
# their photos in a "Notebook photos" folder inside it (src/drive_write.py, drive.file scope).
# Blank: photos stay in the app and the text is still published.
DRIVE_WRITE_FOLDER_ID=

# The Crush document: the Google Doc that work notes and recorded answers are appended to
# (src/drive_write.py; docs/crush-document.md). The id from its address, never a secret.
# Share the doc with the service account as Editor. Set it on the Drive sync service too:
# the sync never indexes this document. Blank: entries stay in the app, with a retry.
DECISIONS_DOC_ID=

# Google sign-in. Generate SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep every real value in the environment or ignored .env, never in git.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated full addresses and/or one domain (without @). At least one
# allowlist setting must be populated before anyone can sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAIN=

# Optional comma-separated subset of allowed addresses that should be leads.
LEAD_EMAILS=

# Drive index (src/drive_index.py). Extra folders/files the index should skip, on top
# of src/drive_index_exclude.txt. Separate rules with ; (see that file for syntax).
# Example: DRIVE_INDEX_EXCLUDE=Pool photos;file: *.log
DRIVE_INDEX_EXCLUDE=

# Drive index ranking (src/drive_rank.py). Extra words that rank a result lower when
# they are in its folder path, on top of src/drive_index_demote.txt. Separate with ;
# Example: DRIVE_INDEX_DEMOTE=Scratch;Spring Break
DRIVE_INDEX_DEMOTE=

# Preview environments only (src/dev_login.py): sign in without Google at /dev-login on a
# Railway PR environment. Set both on the PR environment, never on production. The route
# is also off unless RAILWAY_ENVIRONMENT_NAME (set by Railway) exists and is not "production".
# The preview database must hold only sample data. See CLAUDE.md "Preview environments".
DEV_LOGIN=
DEV_LOGIN_TOKEN=
