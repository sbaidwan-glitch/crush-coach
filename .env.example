# Which environment variables exist. Copied to .env on first build.
# Never put real secrets in this file — it is committed.

# Local Postgres from docker-compose.yml (class 12).
# On Railway, this is replaced by the URL Railway gives you.
DATABASE_URL=postgresql://e190bo:localdev@localhost:5432/app

# Google Drive. Put credentials in one of the first two variables, never here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Coach (src/llm.py). The key stays in the environment, never in this file.
GLASSROOM_API_KEY=
# Model name; blank uses the default (claude-haiku-4-5).
COACH_MODEL=
# The coach routes are off unless this is 1 (until sign-in, #7, lands).
COACH_ENABLED=
# Messages per member per day; blank uses the default (20).
COACH_DAILY_LIMIT=
