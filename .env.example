# Which environment variables exist. Copied to .env on first build.
# Never put real secrets in this file — it is committed.

# Local Postgres from docker-compose.yml (class 12).
# On Railway, this is replaced by the URL Railway gives you.
DATABASE_URL=postgresql://e190bo:localdev@localhost:5432/app

# Google Drive. Put credentials in one of the first two variables, never here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Coach (src/llm.py). The key stays in the environment, never in this file.
GLASSROOM_API_KEY=
# Model name; blank uses the default (claude-sonnet-5).
COACH_MODEL=
# Messages per member per day; blank uses the default (20).
COACH_DAILY_LIMIT=

# Google sign-in. Generate SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep every real value in the environment or ignored .env, never in git.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated full addresses and/or one domain (without @). At least one
# allowlist setting must be populated before anyone can sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAIN=

# Optional comma-separated subset of allowed addresses that should be leads.
LEAD_EMAILS=

# Drive index (src/drive_index.py). Extra folders/files the index should skip, on top
# of src/drive_index_exclude.txt. Separate rules with ; (see that file for syntax).
# Example: DRIVE_INDEX_EXCLUDE=Pool photos;file: *.log
DRIVE_INDEX_EXCLUDE=

# Drive index ranking (src/drive_rank.py). Extra words that rank a result lower when
# they are in its folder path, on top of src/drive_index_demote.txt. Separate with ;
# Example: DRIVE_INDEX_DEMOTE=Scratch;Spring Break
DRIVE_INDEX_DEMOTE=
