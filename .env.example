# Which environment variables exist. Copied to .env on first build.
# Never put real secrets in this file — it is committed.

# Local Postgres from docker-compose.yml (class 12).
# On Railway, this is replaced by the URL Railway gives you.
DATABASE_URL=postgresql://e190bo:localdev@localhost:5432/app

# Google Drive. Put credentials in one of the first two variables, never here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Google sign-in. Generate SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep every real value in the environment or ignored .env, never in git.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated full addresses and/or one domain (without @). At least one
# allowlist setting must be populated before anyone can sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAIN=

# Optional comma-separated subset of allowed addresses that should be leads.
LEAD_EMAILS=
